<form action="" method="post">
    <label for="regEmailInput">Email address</label><br>
    <input type="email" id="regEmailInput" placeholder="Enter email" required><br><br>

    <label for="regPasswordInput">Password</label><br>
    <input type="password" id="regPasswordInput" placeholder="Password" required><br><br>

    <label for="confirmPasswordInput">Confirm Password</label><br>
    <input type="password" id="confirmPasswordInput" placeholder="Confirm Password" required><br><br>

    <button type="submit">Register</button>
</form>
